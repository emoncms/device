          "process": "log_to_feed",
          "arguments": {
            "type": "ProcessArg::FEEDID",
            "value": "grid_Power"
          }
        }
      ]
    },
    {
      "name": "grid_Energy",
      "description": "",
      "processList": [
        {
          "process": "log_to_feed_join",
          "arguments": {
            "type": "ProcessArg::FEEDID",
            "value": "grid_Energy"
          }
        }
      ]
    }
